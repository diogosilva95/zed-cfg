{
  "agent": {
    "default_profile": "write",
    "always_allow_tool_actions": true,
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-latest"
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4"
    }
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "theme": "One Dark",
  "show_edit_predictions": true,
  "vim_mode": true,
  "tab_size": 2,
  "cursor_blink": false,
  "ui_font_size": 12,
  "buffer_font_size": 10,
  "agent_font_size": 12,
  "soft_wrap": "none",
  "ui_font_family": "Zed Plex Sans",
  "buffer_font_family": "Menlo",
  "format_on_save": "on",
  // "formatter": {
  //   "language_server": {
  //     "name": "biome"
  //   }
  // },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false
  },
  "project_panel": {
    "show_diagnostics": "all",
    "indent_guides": {
      "show": "never"
    },
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never"
    }
  },
  "command_aliases": { "Q": "q", "W": "w" },
  "relative_line_numbers": true,
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "code_actions_on_format": {
    "source.fixAll.eslint": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "inlay_hints": {
    "enabled": false,
    "show_other_hints": false,
    "show_parameter_hints": false,
    "show_type_hints": false
  },
  "tabs": {
    "file_icons": true
  },
  "languages": {
    "SQL": {
      "formatter": {
        "external": {
          "command": "sql-formatter",
          "arguments": [
            "--indent",
            "2",
            "--keywords",
            "lowercase",
            "--lines",
            "100",
            "--spaces",
            "4"
          ]
        }
      }
    }
  },
  "experimental.theme_overrides": {
    "background": "#303742",
    "background.appearance": "transparent",
    "surface.background": "#303742",
    "title_bar.background": "#303742",
    "status_bar.background": "#303742",
    "editor.background": "#00000000",
    "editor.gutter.background": "#00000000",
    "editor.active_line.background": "#00000000",
    "panel.background": "#00000000",
    "terminal.background": "#00000000",
    "toolbar.background": "#00000003",
    "scrollbar.track.border": "#00000000",
    "scrollbar.track.background": "#00000000",
    "scrollbar.thumb.border": "00000000",
    "scrollbar.thumb.background": "#00000000",
    "scrollbar.thumb.active_background": "#00000000",
    "scrollbar.thumb.hover_background": "#00000000",
    "tab_bar.background": "#00000000",
    "tab.active_background": "#00000000",
    "tab.inactive_background": "#00000000",
    "elevated_surface.background": "#333b46"
  }
}
