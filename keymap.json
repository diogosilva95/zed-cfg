[
  {
    "bindings": {
      "ctrl ctrl": "agent::ToggleFocus",
      "shift shift": "project_panel::ToggleFocus",
      "ctrl-[": "git::Branch",
      "ctrl-]": "projects::OpenRecent",
      "cmd-m": "agent::ToggleFocus"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "tab": "pane::ActivateNextItem",
      "alt-k": "editor::MoveLineUp",
      "alt-j": "editor::MoveLineDown",
      ">": "editor::Indent",
      "<": "editor::Outdent"
    }
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "[ x": "editor::SelectLargerSyntaxNode",
      "] x": "editor::SelectSmallerSyntaxNode",
      "[ d": "editor::GoToDiagnostic",
      "] d": "editor::GoToPreviousDiagnostic",
      "[ c": "editor::GoToHunk",
      "] c": "editor::GoToPreviousHunk",
      "[ z": "editor::FoldAll",
      "] z": "editor::UnfoldAll"
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "shift shift": "editor::AcceptEditPrediction"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "n": "project_panel::NewFile",
      "shift-n": "project_panel::NewDirectory",
      "d": "project_panel::Trash",
      "shift-d": "project_panel::Delete",
      "r": "project_panel::Rename",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "w": "project_panel::Open",
      "shift-k": "project_panel::CollapseSelectedEntry",
      "shift-j": "project_panel::ExpandSelectedEntry",
      "ctrl-d": ["workspace::SendKeystrokes", "j j j j j j j j"],
      "ctrl-u": ["workspace::SendKeystrokes", "k k k k k k k k"],
      // multi select
      "] d": "project_panel::SelectPrevDiagnostic",
      "[ d": "project_panel::SelectNextDiagnostic"
    }
  }
]
